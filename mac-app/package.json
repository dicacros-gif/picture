{
  "name": "picture-cleaner-mac",
  "version": "2.0.0",
  "description": "Blog manual and automatic writing for Apple Silicon Mac",
  "main": "main.js",
  "author": "dicacros-gif",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac dir --arm64",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "electron": "37.2.3",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.dicacros.picturecleaner.mac",
    "productName": "Blog",
    "asar": true,
    "files": [
      "main.js",
      "blog-runtime.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*"
    ],
    "extraResources": [{ "from": "backend-dist/BlogEngine", "to": "blog-backend" }],
    "mac": {
      "icon": "assets/blog.icns",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "identity": null,
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "artifactName": "Blog-M1-${version}.${ext}"
    }
  }
}
