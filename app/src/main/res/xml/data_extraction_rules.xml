<?xml version="1.0" encoding="utf-8"?>
<!-- API 키·세션 등 민감 데이터가 클라우드/기기이전 백업으로 새어나가지 않게 전부 제외 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
